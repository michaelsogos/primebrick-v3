{
	"folders": [
		{
			"name": "Backend",
			"path": "../primebrick-be-v3"
		},
		{
			"name": "Microservices",
			"path": "../primebrick-us-v3"
		},
		{
			"name": "Frontend",
			"path": "../primebrick-fe-v3"
		},
		{
			"name": "DAL Library",
			"path": "../primebrick-dal-v3"
		},
		{
			"name": "AI Plans",
			"path": "ai-plans"
		}
	],
	"settings": {
		// Forza Windsurf/VSCode a rilevare i 3 archivi Git indipendenti (Sotto-Repo)
		"git.autoRepositoryDetection": "subFolders",
		// TRUCCO CRUCIALE: Impedisce a Cascade di farsi bloccare dai .gitignore superiori
		"search.useIgnoreFiles": false,
		// Impedisce a Cascade di cercare e indicizzare file di build pesanti o immondizia
		"search.exclude": {
			"**/node_modules": true,
			"**/dist": true,
			"**/.svelte-kit": true,
			"**/.git": true,
			"**/build": true
		},
		// Pulisce l'albero visivo laterale nascondendo le cartelle generate automaticamente
		"files.exclude": {
			"**/node_modules": true,
			"**/dist": true,
			"**/.svelte-kit": true,
			"**/build": true
		},
		"workbench.editorAssociations": {
			"*.md": "markdown-preview-enhanced"
		}
	}
}